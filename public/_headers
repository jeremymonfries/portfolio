# Security response headers - Cloudflare's static-assets platform reads
# this file the same way Pages does (this project deploys as Workers
# static assets, no server-side code, so this is the only place these
# can be set - see wrangler.jsonc). Verified locally via `npx wrangler
# dev` before deploying (this file isn't exercised by `astro dev`).
#
# script-src's three hashes are every inline <script>'s exact content
# (Nav's toggle, Lightbox's dialog wiring, Carousel's scroll buttons -
# all static JS, no per-page templated values, so each hashes the same
# everywhere it appears). Regenerate them if any of those three
# components' <script> block changes even slightly - a stale hash means
# the script silently stops running (open console, look for a CSP
# violation on that script) rather than the page failing to build:
#
#   node -e "
#   const {createHash}=require('crypto');
#   const html=require('fs').readFileSync('dist/index.html','utf8');
#   for (const m of html.matchAll(/<script type=\"module\">([\s\S]*?)<\/script>/g))
#     console.log(createHash('sha256').update(m[1]).digest('base64'));
#   "
#
# (run against every page that could contain a script you changed -
# index.html has Nav+Lightbox; projects/microsite/ or patterns/ also
# has Carousel's - then update the matching sha256- value below.)
#
# style-src allows 'unsafe-inline' - Astro emits each page's scoped
# component CSS as one bundled <style> block whose content differs per
# page (unlike the scripts above), so a fixed hash isn't possible
# without a per-route header (impractical to hand-maintain across
# every case study). Inline style="" attributes (ColumnGrid's --cols,
# SectionHeading's text-align override) fall under the same directive.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-LgQThpnumnTG84yQiCrk3Iq/rgGPZ3SU2xWbQM75JPM=' 'sha256-X2Exr9NfmyFA0OtKgb5j2G5LvWZGoA1k3NU0T2TzqtI=' 'sha256-BM67m2o05i+TJ2kAJlyH6MjBfTuZF7buDH+6NwiTYAs='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; frame-src https://www.youtube-nocookie.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
