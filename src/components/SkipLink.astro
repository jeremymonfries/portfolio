---
export interface Props {
  targetId?: string;
}
const { targetId = 'main-content' } = Astro.props;
---

<a class="skip-link" href={`#${targetId}`}>
  Skip to content
</a>

<style>
  /* UX-01: no skip link existed on any of the 11 original pages */
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-2);
    z-index: 4000;
    background: var(--surface-page);
    color: var(--text-body);
    padding: var(--space-2) var(--space-3);
    border-radius: 4px;
    font-weight: 700;
    text-decoration: none;
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: var(--space-2);
  }
</style>
