---
// Replaces `.ufo--column .number h1{font-size:80px}` (case-study.css ~line 14),
// the rule responsible for 2-6 <h1> elements per page on 6/9 original case
// studies (DS-07 / UX-04 / UX-12). A <p> here is structurally incapable of
// repeating that defect.
export interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<p class="stat">
  <span class="stat-value">{value}</span>
  <span class="stat-label">{label}</span>
</p>

<style>
  .stat {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    text-align: center;
  }

  .stat-value {
    font: 700 clamp(40px, 6vw, 80px) / 1 var(--font-display);
    color: var(--text-body);
  }

  .stat-label {
    font-size: 14px;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
</style>
