---
// Reproduces the original site's image-left/text-right section layout
// (see e.g. "Templates or Cards" on the design-system case study) - a
// screenshot alongside its own heading and description, breaking out of
// .case-body's 780px prose column to the full .case-body-section width
// so the image reads at a useful size. `reverse` flips the image to the
// right for visual variety across a sequence of rows.
//
// The image side defaults to a plain <Image> (src/alt props) with its
// own expand button - fine for a normal screenshot. But some sources are
// full-page captures meant to scroll inside a fixed-height device frame,
// not stretch to their full natural height inline (measured one at
// ~4400px tall rendered plain - comparison-chart's UI design intro shot).
// For those, pass the framed content via the named `image` slot (e.g. a
// <DeviceFrame>) instead of src/alt - it replaces the default image
// entirely, including the expand button, since DeviceFrame already
// provides its own.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  src?: ImageMetadata;
  alt?: string;
  reverse?: boolean;
}

const { src, alt, reverse = false } = Astro.props;
---

<div class={`media-row${reverse ? ' media-row--reverse' : ''}`}>
  <div class="media-row__image-wrap">
    <slot name="image">
      <div class="media-row__image-inner" data-lightbox-group>
        <Image src={src!} alt={alt ?? ''} width={900} class="media-row__image" />
        <button
          type="button"
          class="media-row__expand"
          data-lightbox-trigger
          aria-label="View larger"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
            <path
              d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>
      </div>
    </slot>
  </div>
  <div class="media-row__content">
    <slot />
  </div>
</div>

<style>
  .media-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: center;
    margin: var(--space-6) 0;
    /* Same full-bleed breakout as ImageGrid/Carousel: solve
           `100% + 2|M| = min(page-max, 100vw) - 2*gutter` for M, so this
           spans .case-body-section's full width instead of staying capped
           at .case-body's 780px prose column. Degrades to 0 on narrow
           viewports, where there's nothing to break out into. */
    margin-inline: calc((100% - min(var(--page-max), 100vw) + 2 * var(--gutter)) / 2);
  }

  .media-row__image-wrap {
    order: 1;
    min-width: 0;
  }

  .media-row__image-inner {
    position: relative;
  }

  .media-row__image {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border: 1px solid var(--border-default);
    border-radius: 8px;
  }

  /* Same treatment as DeviceFrame/FullBleedImage's expand button -
     always at least partly visible (not hover-only, undiscoverable on
     touch), brightening on hover/focus. */
  .media-row__expand {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  .media-row__image-inner:hover .media-row__expand,
  .media-row__expand:focus-visible {
    opacity: 1;
  }

  .media-row__expand:hover {
    background: rgba(0, 0, 0, 0.75);
  }

  .media-row__expand:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .media-row__content {
    order: 2;
    min-width: 0;
  }

  .media-row--reverse .media-row__image-wrap {
    order: 2;
  }

  .media-row--reverse .media-row__content {
    order: 1;
  }

  .media-row__content :global(> :first-child) {
    margin-top: 0;
  }

  .media-row__content :global(> :last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    .media-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .media-row__image-wrap,
    .media-row--reverse .media-row__image-wrap {
      order: 1;
    }

    .media-row__content,
    .media-row--reverse .media-row__content {
      order: 2;
    }
  }
</style>
