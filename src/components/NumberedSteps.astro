---
export interface Props {
  items: (string | { title: string; body: string })[];
}

const { items } = Astro.props;
---

<ol class="numbered-steps">
  {items.map((item, i) => (
    <li>
      <span class="numbered-steps__num" aria-hidden="true">
        {String(i + 1).padStart(2, '0')}
      </span>
      {typeof item === 'string' ? (
        <span class="numbered-steps__text">{item}</span>
      ) : (
        <>
          <span class="numbered-steps__title">{item.title}</span>
          <span class="numbered-steps__text">{item.body}</span>
        </>
      )}
    </li>
  ))}
</ol>

<style>
  .numbered-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  /* `.case-body :global(ol)` (margin: 0 0 var(--space-3), padding-left:
     1.3em, for plain markdown lists) otherwise wins the cascade here - it
     resolves to one more specificity point (.case-body[data-astro-cid] ol)
     than this component's own scoped `.numbered-steps[data-astro-cid]`.
     Naming the known ancestor explicitly (same fix DeviceFrame uses
     against the same global reset, for img) reliably beats it without
     !important. */
  :global(.case-body) .numbered-steps {
    margin: var(--space-6) 0 var(--space-4);
    padding: 0;
  }

  .numbered-steps li {
    margin: 0;
    padding-top: var(--space-2);
    border-top: 2px solid var(--action-primary-bg);
  }

  .numbered-steps__num {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3.5vw, 40px);
    line-height: 1;
    color: var(--action-primary-bg);
    margin-bottom: var(--space-2);
  }

  .numbered-steps__title {
    display: block;
    font: 700 16px / var(--heading-leading) var(--font-display);
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .numbered-steps__text {
    display: block;
    font-size: 16px;
    line-height: var(--body-leading);
    color: var(--text-body);
  }

  @media (max-width: 700px) {
    .numbered-steps {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
