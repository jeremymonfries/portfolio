---
// A diagram/wireframe image that should read at the full width of the
// page's content section rather than staying capped to .case-body's
// 780px prose column (e.g. torque-drift's Information architecture/
// Wireframes images) - plain content, not a device screenshot, so
// DeviceFrame doesn't apply. Checked the original site directly
// (jeremymonfries.com/p/jeremy.monfries/03119037): these images widen
// to the page's normal content width (.case-body-section, page-max
// 1180px) with the usual side gutters, not edge-to-edge to the browser
// viewport - same breakout formula as ImageGrid/Carousel/MediaRow, not
// ListBand's full-viewport-bleed one. Also has the same click-to-enlarge
// expand button as DeviceFrame (the source has an equivalent
// click-to-zoom), wired to the shared Lightbox via [data-lightbox-group]
// instead of DeviceFrame's own .device-frame lookup.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---

<div class="full-bleed-image" data-lightbox-group>
  <Image src={src} alt={alt} width={src.width} class="full-bleed-image__img" />
  <button
    type="button"
    class="full-bleed-image__expand"
    data-lightbox-trigger
    aria-label="View larger"
  >
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
      <path
        d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
  </button>
</div>

<style>
  .full-bleed-image {
    position: relative;
    margin-block: var(--space-5);
    /* Same full-bleed breakout as ImageGrid/Carousel/MediaRow: solve
       `100% + 2|M| = min(page-max, 100vw) - 2*gutter` for M, so this
       spans .case-body-section's full width instead of staying capped
       at .case-body's 780px prose column. Degrades to 0 on narrow
       viewports, where there's nothing to break out into. */
    margin-inline: calc((100% - min(var(--page-max), 100vw) + 2 * var(--gutter)) / 2);
  }

  .full-bleed-image__img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: 0;
  }

  /* Same treatment as DeviceFrame's expand button - always at least
     partly visible (not hover-only, which is undiscoverable on touch),
     brightening on hover/focus. */
  .full-bleed-image__expand {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  .full-bleed-image:hover .full-bleed-image__expand,
  .full-bleed-image__expand:focus-visible {
    opacity: 1;
  }

  .full-bleed-image__expand:hover {
    background: rgba(0, 0, 0, 0.75);
  }

  .full-bleed-image__expand:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
</style>
