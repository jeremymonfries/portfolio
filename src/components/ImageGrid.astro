---
// Reproduces the original site's `.gallery-layout-module--grid` page-builder
// component (N-column photo grid) so multi-image groups stay grouped in the
// rebuild instead of stacking one-per-row. Used from .mdx case-study body
// content - see rebuild-scope.md section 9.
export interface Props {
  cols?: number;
}

const { cols = 3 } = Astro.props;
---

<div class="image-grid" style={`--cols: ${cols}`}>
  <slot />
</div>

<style>
  .image-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: var(--space-3);
    margin: var(--space-2) 0 var(--space-4);
    /* Break out of .case-body's 780px prose column to use the full
           .case-body-section width (page-max, 1180px) instead - device-frame
           screenshots were unreadably small confined to a 780px-wide row of
           2-4 columns. Same margin-inline: calc() trick as ListBand's
           full-bleed breakout, but targeting the wider section width instead
           of the viewport: solve `100% + 2|M| = min(page-max, 100vw) -
           2*gutter` for M. Degrades safely to 0 on narrow viewports, where
           .case-body already equals .case-body-section's width and there's
           nothing to break out into. */
    margin-inline: calc((100% - min(var(--page-max), 100vw) + 2 * var(--gutter)) / 2);
  }

  /* Grid items default to min-width: auto, sizing 1fr tracks off each
     item's own content instead of dividing space equally - harmless for
     plain images, but breaks badly once items are DeviceFrames with
     different max-widths (laptop/tablet/mobile mixed in one row, e.g.
     norton-gamer): measured the tablet/mobile columns collapsing to 20px
     while laptop took the rest. min-width: 0 is the standard fix. */
  .image-grid > :global(*) {
    min-width: 0;
  }

  .image-grid :global(img) {
    margin: 0;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (max-width: 700px) {
    .image-grid {
      grid-template-columns: repeat(min(2, var(--cols)), 1fr);
    }
  }
</style>
