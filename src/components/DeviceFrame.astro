---
// Wraps a single screenshot in a device frame so UI-design screenshots
// read as "a design on a device" rather than a bare image - matches the
// original site's device-mockup treatment (see HANDOFF.md).
//
// mobile/mobile-landscape/laptop use real photorealistic mockup PNGs
// (user-supplied "Apple iPhone 16 Black" renders, and a separate MacBook
// mockup for laptop) instead of a CSS-drawn bezel - after repeated rounds
// of the hand-drawn laptop/tablet/mobile shapes looking like "a weird
// hybrid" of devices, real mockup art was the right fix, not more CSS
// tuning. The screenshot sits in an absolutely-positioned box behind the
// frame PNG, sized to the frame's actual transparent screen cutout -
// measured directly from each PNG's alpha channel (scanned the center
// row/column for transparent-region bounds) rather than guessed, since
// the cutout isn't a round number and the source files have no metadata
// for it:
//   iphone-portrait.png:  screen inset  top/bottom 2.3%, left/right 5.3%
//   iphone-landscape.png: screen inset  top/bottom 5.3%, left/right 2.3%
//   (landscape is the portrait art rotated 90°, so the insets transpose.)
//   laptop.png: screen inset top 6%, right 12.1%, bottom 19.8%, left 12.1%
//   (bottom inset is much bigger than top - that's the keyboard deck/base
//   below the actual screen, baked into the same image.)
//
// Export gotcha: sharp's `png({ palette: true })` (used for file size)
// quantizes colour, and does it badly on partially-transparent edge
// pixels - it was writing a garbage mid-grey RGB (measured: 76,105,113)
// into pixels that should have been black-but-transparent. Composited
// over a light part of a screenshot, that read as a thin light/white
// line right at the inside edge of the frame. Confirmed directly against
// the untouched source files that they don't have this - re-exporting
// without `palette: true` keeps the transparent-adjacent RGB at the
// correct (0,0,0) and the line is gone. Don't add palette mode back to
// these three exports.
//
// tablet is still CSS-drawn (no real asset for it yet) - see the
// aspect-ratio-as-viewport-window comment further down for how that
// works.
export interface Props {
  variant?: 'laptop' | 'tablet' | 'mobile' | 'mobile-landscape';
  label?: string;
  /** The screenshot is a single complete screen (e.g. a game UI), not a
   * tall page capture - show it whole (object-fit: contain, letterboxed
   * if the aspect doesn't match exactly) instead of at natural height
   * with a scrollable overflow. Default false keeps the scroll behavior
   * every other DeviceFrame usage relies on (full-page screenshots up to
   * ~12,000px tall - see the scroll-viewport comment below). */
  fit?: boolean;
}

const { variant = 'laptop', label, fit = false } = Astro.props;
const isPhoto = variant === 'mobile' || variant === 'mobile-landscape' || variant === 'laptop';
const hasButton = variant === 'tablet';
const frameClass = `device-frame device-frame--${variant}${fit ? ' device-frame--fit' : ''}`;
// Nothing to scroll in `fit` mode, so the screen doesn't need to be a
// focusable/labeled region - the img's own alt text already describes it.
const screenAttrs = fit
  ? {}
  : { tabindex: 0, role: 'group', 'aria-label': label ?? 'Screenshot, scroll to see more' };
---

{isPhoto ? (
  <div class={frameClass}>
    <div class="device-frame__photo">
      <div class="device-frame__screen" {...screenAttrs}>
        <slot />
      </div>
      <img
        class="device-frame__overlay"
        src={
          {
            mobile: '/device-frames/iphone-portrait.png',
            'mobile-landscape': '/device-frames/iphone-landscape.png',
            laptop: '/device-frames/laptop.png',
          }[variant]
        }
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
      <button
        type="button"
        class="device-frame__expand"
        data-lightbox-trigger
        aria-label="View larger"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          <path
            d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>
) : (
  <div class={frameClass}>
    <div class="device-frame__bezel">
      <div class="device-frame__screen" {...screenAttrs}>
        <slot />
      </div>
      <button
        type="button"
        class="device-frame__expand"
        data-lightbox-trigger
        aria-label="View larger"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          <path
            d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
    </div>
    {hasButton && <div class="device-frame__button" aria-hidden="true" />}
  </div>
)}

<style>
  .device-frame {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Shared scroll-viewport behavior for every variant's screen area,
     photo-framed or CSS-drawn. The screen shows the screenshot at full
     natural height (not cropped) inside a fixed-aspect-ratio window that
     scrolls (overflow-y: auto) to reveal the rest - matches the live
     site's own ".mockup.scrollable" behavior (confirmed directly:
     scrolling over one of their laptop frames scrolls the screenshot
     inside the frame, not the page), and is why several source
     screenshots are full-page captures up to ~12,000px tall - the whole
     page stays reachable instead of only the top being visible. */
  .device-frame__screen {
    position: relative;
    /* Black, matching the phone bezel - any letterboxing in `fit` mode
           (or the rare natural-height screenshot that falls short of the
           frame's aspect ratio) then reads as part of the device, not as a
           broken white patch. (Diagram screenshots with a transparent
           background used to need white here, but that content no longer
           goes through DeviceFrame at all - see torque-drift's Information
           architecture/Wireframes sections.) */
    background: #000;
    overflow-x: hidden;
    overflow-y: auto;
    /* Defensive: CSS scroll anchoring can silently shift an overflow
           container's scrollTop to compensate for layout shifts elsewhere on
           the page (e.g. lazy-loaded images resolving their real height) -
           exactly the shape of "starts scrolled partway, can't get back to
           the top" reports. */
    overflow-anchor: none;
    /* Stop this container's own scroll from chaining to the page (or, in
           a carousel, to the horizontal viewport) once it hits its own top or
           bottom edge. */
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.25) transparent;
  }

  .device-frame__screen::-webkit-scrollbar {
    width: 6px;
  }

  .device-frame__screen::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.25);
    border-radius: 3px;
  }

  .device-frame__screen:focus-visible {
    outline: 2px solid var(--action-primary-bg);
    outline-offset: -2px;
  }

  /* Natural width/height (no object-fit crop) - two classes deep so this
     reliably beats ImageGrid's own `.image-grid :global(img)` rule when a
     DeviceFrame is nested inside an ImageGrid (mixed device-type groups,
     e.g. homepage-redesign) - but width/height alone isn't enough:
     ImageGrid also sets `aspect-ratio: 4/3; object-fit: cover` on every
     img it contains, and a rule that never touches those two properties
     leaves them in effect regardless of specificity (CSS cascades per
     property, not per rule). That silently center-crops the screenshot to
     a 4:3 box before the scroll viewport even comes into play. Reset both
     explicitly.
     margin/border-radius reset for the same reason: `.case-body
     :global(img)` (the page's default prose-image styling) sets
     `margin: 16px 0 32px; border-radius: 8px` on every img in the body
     text, screenshots inside a device frame included - measured a
     consistent 16px gap at the top of every laptop frame's screen from
     exactly this, even though width/height/aspect-ratio/object-fit were
     already reset. */
  .device-frame .device-frame__screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: auto;
    object-fit: unset;
    margin: 0;
    border-radius: 0;
  }

  /* `fit` mode: the screenshot is one complete screen, not a tall page
     capture - show the whole thing scaled to fit (letterboxed on
     whichever axis doesn't match exactly) instead of natural height +
     scroll. */
  .device-frame--fit .device-frame__screen {
    overflow: hidden;
  }

  .device-frame--fit .device-frame__screen :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Enlarge button: bottom-right corner of the actual screen area (not
     the whole frame image, which would land it in the bezel/base for
     variants with a big bottom inset like laptop). Positioned per-variant
     to match that variant's own screen inset, rather than the frame's
     outer box. Sits above the frame overlay purely by DOM order (comes
     after it, both position: absolute, no z-index needed) - and above
     the scrollable screen since it's a sibling of it, not a child, so it
     never scrolls away with tall content. */
  .device-frame__expand {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    /* Always at least partly visible (not hover-only: opacity: 0 with a
           hover reveal is undiscoverable on touch, which has no hover). */
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  .device-frame:hover .device-frame__expand,
  .device-frame__expand:focus-visible {
    opacity: 1;
  }

  .device-frame__expand:hover {
    background: rgba(0, 0, 0, 0.75);
  }

  .device-frame__expand:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* --- Photo-framed variants (mobile, mobile-landscape, laptop) --- */

  .device-frame--mobile .device-frame__photo,
  .device-frame--mobile-landscape .device-frame__photo,
  .device-frame--laptop .device-frame__photo {
    position: relative;
    width: 100%;
  }

  .device-frame--mobile .device-frame__photo {
    max-width: 320px;
    aspect-ratio: 440 / 896;
  }

  .device-frame--mobile-landscape .device-frame__photo {
    aspect-ratio: 900 / 442;
  }

  .device-frame--laptop .device-frame__photo {
    aspect-ratio: 700 / 449;
  }

  .device-frame--mobile .device-frame__screen {
    position: absolute;
    inset: 2.3% 5.3%;
    border-radius: 28px;
  }

  .device-frame--mobile .device-frame__expand {
    bottom: calc(2.3% + 6px);
    right: calc(5.3% + 6px);
  }

  .device-frame--mobile-landscape .device-frame__screen {
    position: absolute;
    inset: 5.3% 2.3%;
    border-radius: 22px;
  }

  .device-frame--mobile-landscape .device-frame__expand {
    bottom: calc(5.3% + 6px);
    right: calc(2.3% + 6px);
  }

  .device-frame--laptop .device-frame__screen {
    position: absolute;
    inset: 6% 12.1% 19.8% 12.1%;
    border-radius: 2px;
  }

  .device-frame--laptop .device-frame__expand {
    bottom: calc(19.8% + 6px);
    right: calc(12.1% + 6px);
  }

  /* Same ImageGrid aspect-ratio/object-fit leak as the screenshot img
     (see the big comment above) hits this decorative overlay img too,
     since it's just as much a descendant of .image-grid - reset the
     same properties here. */
  .device-frame .device-frame__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: fill;
    margin: 0;
    /* The frame art sits on top with a transparent screen cutout showing
           the real screenshot through it - pointer-events: none so clicks
           and wheel scrolling still reach .device-frame__screen underneath. */
    pointer-events: none;
  }

  /* --- CSS-drawn variant (tablet) - no real mockup asset yet --- */

  .device-frame__bezel {
    position: relative;
    width: 100%;
    background: linear-gradient(180deg, #3a3c40, #1c1d20);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.16);
  }

  /* Tablet: uniform bezel with a home-button dot */
  .device-frame--tablet .device-frame__bezel {
    border-radius: 20px;
    padding: 16px 10px;
  }

  .device-frame--tablet .device-frame__screen {
    aspect-ratio: 4 / 3;
    border-radius: 4px;
  }

  .device-frame--tablet .device-frame__expand {
    bottom: 22px;
    right: 16px;
  }

  /* The width cap lives on __bezel (a normal flex child, centered by the
     parent's `align-items: center`), not on .device-frame itself - putting
     max-width + margin-inline: auto on the grid/flex ITEM triggers CSS
     Grid's auto-margin sizing behavior, which shrinks the item to its
     content size instead of stretching to its track (measured: collapsed
     a mixed laptop/tablet/mobile ImageGrid row's tablet/mobile columns to
     20px). Capping __bezel instead centers a lone frame in the prose
     column while leaving the outer grid item free to size normally. */
  .device-frame--tablet .device-frame__bezel {
    max-width: 420px;
  }

  .device-frame--tablet .device-frame__button {
    width: 8px;
    height: 8px;
    margin-top: 10px;
    border-radius: 50%;
    background: #3a3c40;
  }
</style>
