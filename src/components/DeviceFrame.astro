---
// Wraps a single screenshot in a laptop/tablet/mobile bezel so UI-design
// screenshots read as "a design on a device" rather than a bare image -
// matches the original site's device-mockup treatment (see HANDOFF.md).
// The screen area is a fixed aspect ratio per variant acting as a
// viewport window, not a crop: the image is shown at its full natural
// height and the window scrolls (overflow-y: auto) to reveal the rest.
// This matches the live site's own ".mockup.scrollable" behavior
// (confirmed: scrolling over one of their laptop frames scrolls the
// screenshot inside the frame, not the page) and is why several source
// screenshots are full-page captures up to ~12,000px tall - the whole
// page stays reachable instead of only the top being visible.
export interface Props {
  variant?: 'laptop' | 'tablet' | 'mobile';
  label?: string;
}

const { variant = 'laptop', label } = Astro.props;
---

<div class={`device-frame device-frame--${variant}`}>
  <div class="device-frame__bezel">
    <div
      class="device-frame__screen"
      tabindex="0"
      role="group"
      aria-label={label ?? 'Screenshot, scroll to see more'}
    >
      <slot />
    </div>
  </div>
  {variant === 'laptop' && <div class="device-frame__base" aria-hidden="true"></div>}
  {variant !== 'laptop' && <div class="device-frame__button" aria-hidden="true"></div>}
</div>

<style>
  .device-frame {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .device-frame__bezel {
    width: 100%;
    background: linear-gradient(180deg, #3a3c40, #1c1d20);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.16);
  }

  .device-frame__screen {
    /* White, not black: a couple of source screenshots (diagram exports)
       are transparent PNGs, and a black screen behind a transparent
       diagram reads as broken/inverted rather than "off". */
    background: #fff;
    overflow-x: hidden;
    overflow-y: auto;
    /* Defensive: CSS scroll anchoring can silently shift an overflow
       container's scrollTop to compensate for layout shifts elsewhere on
       the page (e.g. lazy-loaded images resolving their real height) -
       exactly the shape of "starts scrolled partway, can't get back to
       the top" reports. Not reproduced in scripted testing, but there's
       no reason to leave it enabled on a container whose whole point is
       showing content from the top. */
    overflow-anchor: none;
    /* Stop this container's own scroll from chaining to the page (or, in
       a carousel, to the horizontal viewport) once it hits its own top or
       bottom edge - reduces surprising cross-talk between this vertical
       scroll and any scrollable ancestor. */
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.25) transparent;
  }

  .device-frame__screen::-webkit-scrollbar {
    width: 6px;
  }

  .device-frame__screen::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.25);
    border-radius: 3px;
  }

  .device-frame__screen:focus-visible {
    outline: 2px solid var(--action-primary-bg);
    outline-offset: -2px;
  }

  /* Natural width/height (no object-fit crop) - the screen's fixed
     aspect-ratio caps what's visible without scrolling, and the rest of
     a tall screenshot scrolls into view. Two classes deep so this
     reliably beats ImageGrid's own `.image-grid :global(img)` rule when
     a DeviceFrame is nested inside an ImageGrid (mixed device-type
     groups, e.g. homepage-redesign) - but width/height alone isn't
     enough: ImageGrid also sets `aspect-ratio: 4/3; object-fit: cover`
     on every img it contains, and since this rule never touched those
     two properties they kept applying regardless of specificity (CSS
     cascades per property, not per rule). That silently center-cropped
     every screenshot to a 4:3 box before the scroll viewport even came
     into play - the "can't scroll to the real top" bug was this, not
     the scroll container. Must reset both explicitly. */
  .device-frame .device-frame__screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: auto;
    object-fit: unset;
  }

  /* Laptop: light/silver body (checked against the live site's actual
     laptop-mockup SVG - it's a white/near-white chassis with a thin
     screen border, not a dark bezel; dark only reads right on
     tablet/mobile, which are genuinely dark-chassis devices). A border +
     shadow gives it an edge against a white page, since white-on-white
     alone has no visible boundary. The base below is wider than the
     screen (a real laptop's keyboard deck overhangs the lid) with a
     small centered notch standing in for the trackpad/hinge detail. */
  .device-frame--laptop .device-frame__bezel {
    background: #f4f5f6;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px 10px 3px 3px;
    padding: 10px 10px 6px;
  }

  .device-frame--laptop .device-frame__screen {
    aspect-ratio: 16 / 10;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 2px;
  }

  /* Flush with the bezel, no overhang - an overhanging base (tried at
     both a 6% and a fixed-8px margin) kept colliding with or being
     clipped by whatever sits next to it (adjacent carousel/grid columns,
     or the edge of the scroll container for the first/last item, which
     has no gap to absorb an overhang into). Not worth the visual
     flourish given two rounds of edge-clipping bugs from it. */
  .device-frame--laptop .device-frame__base {
    position: relative;
    width: 100%;
    height: 10px;
    background: linear-gradient(180deg, #f7f8f9, #dcdee0);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-top: none;
    border-radius: 0 0 6px 6px;
  }

  .device-frame--laptop .device-frame__base::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    width: 15%;
    height: 3px;
    background: rgba(0, 0, 0, 0.12);
    border-radius: 0 0 6px 6px;
    transform: translateX(-50%);
  }

  /* Tablet/mobile: uniform bezel with a home-button dot */
  .device-frame--tablet .device-frame__bezel,
  .device-frame--mobile .device-frame__bezel {
    border-radius: 20px;
    padding: 16px 10px;
  }

  .device-frame--tablet .device-frame__screen {
    aspect-ratio: 4 / 3;
    border-radius: 4px;
  }

  .device-frame--mobile .device-frame__screen {
    aspect-ratio: 9 / 16;
    border-radius: 4px;
  }

  /* The width cap lives on __bezel (a normal flex child, centered by the
     parent's `align-items: center`), not on .device-frame itself - putting
     max-width + margin-inline: auto on the grid/flex ITEM triggers CSS
     Grid's auto-margin sizing behavior, which shrinks the item to its
     content size instead of stretching to its track (measured: collapsed
     a mixed laptop/tablet/mobile ImageGrid row's tablet/mobile columns to
     20px). Capping __bezel instead centers a lone frame in the prose
     column while leaving the outer grid item free to size normally. */
  .device-frame--tablet .device-frame__bezel {
    max-width: 320px;
  }

  .device-frame--mobile .device-frame__bezel {
    max-width: 220px;
  }

  .device-frame--tablet .device-frame__button,
  .device-frame--mobile .device-frame__button {
    width: 8px;
    height: 8px;
    margin-top: 10px;
    border-radius: 50%;
    background: #3a3c40;
  }
</style>
