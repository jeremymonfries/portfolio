---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Jeremy Monfries — UX & Product Designer">
  <section style="padding: var(--space-7) var(--gutter); max-width: var(--page-max); margin: 0 auto;">
    <h1 style="font: 700 var(--heading-h1)/var(--heading-leading) var(--font-display); margin: 0 0 var(--space-3);">
      Jeremy Monfries
    </h1>
    <p style="color: var(--text-muted); font-size: 18px; max-width: 640px;">
      Rebuild skeleton — layout, tokens, and nav are wired up. Case-study content migration is the
      next phase (see rebuild-scope.md section 9).
    </p>
    <a
      class="cta"
      href="/about"
      style="display: inline-block; background: var(--cta-bg); color: var(--cta-text); text-decoration: none; border-radius: 999px; padding: 9px 18px; font-weight: 700; margin-top: var(--space-3);"
    >
      About
    </a>
  </section>
</BaseLayout>
