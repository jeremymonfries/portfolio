---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import profilePhoto from '../assets/profile/jeremy-monfries.jpeg';

const skills = [
  'Product Design',
  'UX Strategy',
  'User Experience Design',
  'User-centred Design',
  'Design Management',
  'Design Strategy',
  'User Interface Design',
  'eCommerce',
  'Interaction Design',
  'Mobile Applications',
  'Design Systems',
  'Product Strategy',
  'Visual Design',
  'Wireframes',
  'Prototyping',
  'Customer Insights',
  'Information Architecture',
  'Requirements Gathering',
  'Storytelling',
  'User Research',
  'User Testing',
  'Product Management',
  'Human Centred Design',
  'Design Thinking',
  'Data Analysis',
  'Agile Methodologies',
  'Team Leadership',
];

// UX-05/DS-07: the original home page duplicated every project as both a
// "featured" teaser and a "grid" entry (2 image files + 2 markup blocks
// per case study). This rebuild has exactly one content source
// (getCollection) and one rendered list - the duplication can't recur.
const caseStudies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Jeremy Monfries — Lead Product/UX/UI Designer"
  description="I'm a designer with over 25 years experience working internationally in a variety of multinational businesses."
>
  <div class="home">
    <aside class="profile">
      <Image
        src={profilePhoto}
        alt="Jeremy Monfries"
        class="profile-photo"
        width={240}
        height={240}
      />
      <h1>Jeremy Monfries</h1>
      <p class="role">Lead Product/UX/UI</p>
      <p class="bio">
        I'm a designer with over 25 years experience working internationally in a variety of
        multinational businesses. I'm passionate about creating human-centred, highly-usable digital
        experiences.
      </p>
      <ul class="skills">
        {skills.map((skill) => (
          <li>{skill}</li>
        ))}
      </ul>
    </aside>

    <section class="grid" aria-label="Case studies">
      {caseStudies.map((entry) => (
        <a class="card" href={`/projects/${entry.id}/`}>
          <Image
            src={entry.data.heroImage.src}
            alt={entry.data.heroImage.alt}
            class="card-image"
            width={640}
            height={420}
          />
          <div class="card-body">
            <h2>{entry.data.title}</h2>
            <p>{entry.data.summary}</p>
            {entry.data.skills.length > 0 && (
              <ul class="card-skills">
                {entry.data.skills.map((skill) => (
                  <li class="chip">{skill}</li>
                ))}
              </ul>
            )}
          </div>
        </a>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding: var(--space-7) var(--gutter);
    max-width: var(--page-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .profile {
    position: sticky;
    top: var(--space-4);
  }

  .profile-photo {
    display: block;
    width: 100%;
    max-width: 200px;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    margin: 0 auto var(--space-3);
  }

  .profile h1 {
    font: 700 var(--heading-h2) / var(--heading-leading) var(--font-display);
    margin: 0 0 var(--space-1);
  }

  .role {
    font-size: 18px;
    color: var(--text-muted);
    margin: 0 0 var(--space-3);
  }

  .bio {
    font-size: 18px;
    margin: 0 0 var(--space-3);
  }

  .skills {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    font-size: 16px;
    color: var(--text-muted);
  }

  .skills li {
    display: inline;
  }

  .skills li:not(:last-child)::after {
    content: '|';
    margin: 0 6px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
    /* Subtle dot-grid canvas behind the cards - padding+negative margin
       cancel out so the grid's own outer edges stay exactly where they
       were, but the dots show through in the gaps between cards and in
       the breathing room around them, helping the solid-white bordered
       cards read as floating on top of it rather than just sitting on
       the page background. */
    background-image: radial-gradient(rgba(40, 42, 43, 0.1) 1.5px, transparent 0);
    background-size: 22px 22px;
    border-radius: 16px;
    padding: var(--space-4);
    margin: calc(var(--space-4) * -1);
  }

  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    border-radius: 12px;
    overflow: hidden;
    transition:
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .card:hover,
  .card:focus-visible {
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  .card-image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-3);
  }

  .card h2 {
    font: 700 20px / var(--heading-leading) var(--font-display);
    margin: 0 0 var(--space-1);
  }

  .card p {
    font-size: 15px;
    color: var(--text-muted);
    margin: 0;
  }

  .card:hover h2,
  .card:focus-visible h2 {
    color: var(--action-primary-bg);
  }

  .card-skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    margin-top: auto;
    padding: var(--space-2) 0 0;
  }

  .chip {
    font: 700 12px / 1 var(--font-display);
    letter-spacing: 0.01em;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--surface-tint);
    color: var(--action-primary-bg);
    white-space: nowrap;
  }

  @media (max-width: 800px) {
    .home {
      grid-template-columns: 1fr;
    }

    .profile {
      position: static;
    }
  }
</style>
