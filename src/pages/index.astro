---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import profilePhoto from '../assets/profile/jeremy-monfries.jpeg';

const skills = [
  'Product Design',
  'UX Strategy',
  'User Experience Design',
  'User-centred Design',
  'Design Management',
  'Design Strategy',
  'User Interface Design',
  'eCommerce',
  'Interaction Design',
  'Mobile Applications',
  'Design Systems',
  'Product Strategy',
  'Visual Design',
  'Wireframes',
  'Prototyping',
  'Customer Insights',
  'Information Architecture',
  'Requirements Gathering',
  'Storytelling',
  'User Research',
  'User Testing',
  'Product Management',
  'Human Centred Design',
  'Design Thinking',
  'Data Analysis',
  'Agile Methodologies',
  'Team Leadership',
];

// UX-05/DS-07: the original home page duplicated every project as both a
// "featured" teaser and a "grid" entry (2 image files + 2 markup blocks
// per case study). This rebuild has exactly one content source
// (getCollection) and one rendered list - the duplication can't recur.
const caseStudies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Jeremy Monfries — Lead Product/UX/UI Designer"
  description="I'm a designer with over 25 years experience working internationally in a variety of multinational businesses."
>
  <div class="home-bg">
    <div class="home">
      <aside class="profile">
        <Image
          src={profilePhoto}
          alt="Jeremy Monfries"
          class="profile-photo"
          width={240}
          height={240}
        />
        <h1>Jeremy Monfries</h1>
        <p class="role">Lead Product/UX/UI</p>
        <p class="bio">
          I'm a designer with over 25 years experience working internationally in a variety of
          multinational businesses. I'm passionate about creating human-centred, highly-usable
          digital experiences.
        </p>
        <ul class="skills">
          {skills.map((skill) => (
            <li>{skill}</li>
          ))}
        </ul>
      </aside>

      <section class="grid" aria-label="Case studies">
        {caseStudies.map((entry) => (
          <a class="card" href={`/projects/${entry.id}/`}>
            <Image
              src={entry.data.heroImage.src}
              alt={entry.data.heroImage.alt}
              class="card-image"
              width={640}
              height={420}
            />
            <div class="card-body">
              <h2>{entry.data.title}</h2>
              <p>{entry.data.summary}</p>
              {entry.data.skills.length > 0 && (
                <ul class="card-skills">
                  {entry.data.skills.map((skill) => (
                    <li class="chip">{skill}</li>
                  ))}
                </ul>
              )}
            </div>
          </a>
        ))}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* Full-viewport-width wrapper so the dot canvas below can reach the
     true right/top/bottom edges of the page rather than stopping at
     .home's own max-width (min(page-max,100vw)) - .home itself stays
     the centred, gutter-padded, max-width content column it always
     was; this just wraps it for the background layer's benefit. */
  .home-bg {
    /* Wider than the sitewide --page-max (1180px, tuned for prose
       readability on case-study/about pages) - the card grid isn't a
       reading column, it's a visual gallery, and at wide viewports
       capping it to --page-max left the cards narrow with a large
       unused patterned strip on the right. Kept as its own constant
       (rather than just raising --page-max) so this doesn't affect
       any other page's content width. Set here (not on .home) so both
       this rule's --home-split and .home's own max-width - a
       descendant, so it inherits this custom property - can use it. */
    --home-max: 1600px;
    /* Where the sidebar column ends and the case-study column begins,
       measured from the true left edge of the viewport: half of
       .home's own auto-centring margin, plus its left gutter padding,
       plus the sidebar's own track width and the grid gap beside it.
       Same breakout math the rest of the site uses for full-bleed
       elements (see ImageGrid/MediaRow/etc's margin-inline calc),
       just solved for a single edge instead of both. */
    --home-split: calc(
      (100vw - min(var(--home-max), 100vw)) / 2 + var(--gutter) + 280px + var(--space-6)
    );
    /* Isometric "tumbling blocks" tile (public/patterns/isometric-cubes.svg)
       - generated (not hand-traced) from exact hex-grid math: pointy-top
       hexagons split into 3 rhombi via spokes to alternating vertices.
       Grid period (R=30), stroke weight and fill/line colours were all
       measured directly off the reference photo (autocorrelation for
       the true repeat distance, pixel run-lengths for stroke width,
       raw pixel sampling for colour) rather than eyeballed. A periodic
       (still seamless) hash decides which outline edges to omit and
       which of a weighted set of spoke patterns each hex gets - biased
       toward a single bent path through the cell, which is the
       dominant look in the reference, with full 3-way corners and
       empty cells as rarer accents - so cells read as a dense woven
       maze rather than a uniform honeycomb. Colour is baked into the
       SVG itself, since an external background-image can't inherit
       currentColor from this page. */
    background-image:
      linear-gradient(
        to right,
        var(--surface-page) 0,
        var(--surface-page) var(--home-split),
        transparent var(--home-split)
      ),
      url('/patterns/isometric-cubes.svg');
    background-size:
      100% 100%,
      129.904px 135px;
    background-repeat: no-repeat, repeat;
  }

  .home {
    padding: var(--space-7) var(--gutter);
    max-width: var(--home-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .profile {
    position: sticky;
    top: var(--space-4);
  }

  .profile-photo {
    display: block;
    width: 100%;
    max-width: 200px;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    margin: 0 auto var(--space-3);
  }

  .profile h1 {
    /* Deliberately a fixed size, not --heading-h2 or any vw-based
       clamp - the sidebar column is a fixed 280px on desktop (see
       .home's grid-template-columns) regardless of viewport width, so
       a font that keeps growing with the viewport eventually needs
       more room than that fixed column has and wraps "Jeremy
       Monfries" onto two lines. 32px comfortably fits it at any
       viewport, on the single full-width mobile column too. */
    font: 700 32px / var(--heading-leading) var(--font-display);
    margin: 0 0 var(--space-1);
  }

  .role {
    font-size: 18px;
    color: var(--text-muted);
    margin: 0 0 var(--space-3);
  }

  .bio {
    font-size: 18px;
    margin: 0 0 var(--space-3);
  }

  .skills {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    font-size: 16px;
    color: var(--text-muted);
  }

  .skills li {
    display: inline;
  }

  .skills li:not(:last-child)::after {
    /* A space either side of the "|" (rather than CSS margin) so there's
       an actual breakable character between list items - margin alone
       isn't a valid line-break opportunity, so when a line ran out of
       room right at a separator the next word glued itself to the end
       of the previous line and overflowed the column instead of
       wrapping (e.g. "Customer" in "Prototyping | Customer Insights"
       spilling into the card grid beside it). */
    content: ' | ';
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
    /* Left inset so the cards don't sit flush against .home-bg's split
       point - without this there was no visible pattern between the
       white sidebar and the first card, even though the pattern shows
       everywhere else around/between the cards. */
    padding-left: var(--space-6);
  }

  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    border-radius: 12px;
    overflow: hidden;
    transition:
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .card:hover,
  .card:focus-visible {
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  .card-image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-3);
  }

  .card h2 {
    font: 700 20px / var(--heading-leading) var(--font-display);
    margin: 0 0 var(--space-1);
  }

  .card p {
    font-size: 15px;
    color: var(--text-muted);
    margin: 0;
  }

  .card:hover h2,
  .card:focus-visible h2 {
    color: var(--action-primary-bg);
  }

  .card-skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    margin-top: auto;
    padding: var(--space-2) 0 0;
  }

  .chip {
    font: 700 12px / 1 var(--font-display);
    letter-spacing: 0.01em;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--surface-tint);
    color: var(--action-primary-bg);
    white-space: nowrap;
  }

  @media (max-width: 800px) {
    /* The split point above assumes the sidebar sits beside the grid;
       once they stack (below), there's no vertical seam to compute
       without measuring rendered content height, so just drop the
       dot layer rather than let it land somewhere arbitrary. */
    .home-bg {
      background-image: none;
    }

    .home {
      grid-template-columns: 1fr;
    }

    .profile {
      position: static;
    }

    /* The left inset exists to reveal pattern between the sidebar and
       the cards - once they stack there's no pattern to reveal (see
       .home-bg above), so it'd just eat into the single mobile column
       asymmetrically for no reason. */
    .grid {
      padding-left: 0;
    }
  }
</style>
