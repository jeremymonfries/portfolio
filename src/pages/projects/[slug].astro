---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatBlock from '../../components/StatBlock.astro';
import Tldr from '../../components/Tldr.astro';

export async function getStaticPaths() {
  const entries = await getCollection('case-studies', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'case-studies'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} — Jeremy Monfries`} description={entry.data.summary}>
  <article class="hero-section">
    <h1 class="title">{entry.data.title}</h1>
    <p class="summary">{entry.data.summary}</p>
    <Image
      src={entry.data.heroImage.src}
      alt={entry.data.heroImage.alt}
      width={1180}
      height={700}
      class="hero-image"
    />
  </article>

  <Tldr text={entry.data.tldr} />

  {entry.data.stats.length > 0 && (
    <section class="stats-band" aria-label="Key results">
      <div class="stats-grid">
        {entry.data.stats.map((stat) => (
          <StatBlock value={stat.value} label={stat.label} />
        ))}
      </div>
    </section>
  )}

  <article class="case-body-section">
    <div class="case-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .hero-section {
    padding: var(--space-7) var(--gutter) 0;
    max-width: var(--page-max);
    margin: 0 auto;
  }

  .title {
    font: 200 var(--heading-h1) / var(--heading-leading) var(--font-display);
    margin: 0 0 var(--space-3);
  }

  .summary {
    font: 500 22px / 1.4 var(--font-display);
    color: var(--text-muted);
    max-width: 700px;
    margin: 0 0 var(--space-5);
  }

  .hero-image {
    width: 100%;
    height: auto;
    border-radius: 24px;
  }

  /* DS-07/UX-04/UX-12: the original site's stat numbers lived in a plain
     white section with no visual separation from the rest of the page.
     A full-bleed dark band gives the results their own moment and breaks
     up an otherwise all-white page - see rebuild-scope.md section 9.
     Padding matches Tldr/ListBand (the site's other two full-bleed
     bands, both --space-5) rather than the --space-6 this used to have -
     three bands doing the same "full-bleed band directly under the
     hero" job should feel like one consistent rhythm, not two. */
  .stats-band {
    background: var(--surface-sidebar);
    padding: var(--space-5) 0;
  }

  .stats-grid {
    width: min(var(--page-max), calc(100% - 2 * var(--gutter)));
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .stats-band :global(.stat-value) {
    color: var(--color-white);
  }

  .stats-band :global(.stat-label) {
    color: var(--color-neutral-200);
  }

  @media (max-width: 700px) {
    .hero-image {
      border-radius: 12px;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }

  .case-body-section {
    padding: var(--space-6) var(--gutter) var(--space-7);
    max-width: var(--page-max);
    margin: 0 auto;
  }

  .case-body {
    /* Centered (not flush-left) on wide viewports where the 780px cap is
           narrower than .case-body-section's content width. This also matters
           for ListBand's full-bleed breakout (margin-inline: calc(50% - 50vw)
           in ListBand.astro) - that trick only spans the true viewport width
           when its reference box is itself centered on the page. */
    max-width: 780px;
    margin-inline: auto;
    font-size: 16px;
    line-height: var(--body-leading);
  }

  .case-body :global(h2) {
    font: 700 var(--heading-h3) / var(--heading-leading) var(--font-display);
    margin: var(--space-6) 0 var(--space-3);
    text-align: center;
  }

  .case-body :global(h3) {
    font: 700 var(--heading-h4) / var(--heading-leading) var(--font-display);
    margin: var(--space-5) 0 var(--space-2);
  }

  .case-body :global(h4) {
    font: 700 16px / var(--heading-leading) var(--font-display);
    margin: var(--space-4) 0 var(--space-1);
    color: var(--text-muted);
  }

  .case-body :global(p) {
    margin: 0 0 var(--space-3);
  }

  .case-body :global(ul),
  .case-body :global(ol) {
    margin: 0 0 var(--space-3);
    padding-left: 1.3em;
  }

  .case-body :global(li) {
    margin-bottom: var(--space-1);
  }

  .case-body :global(img) {
    border-radius: 8px;
    margin: var(--space-2) 0 var(--space-4);
  }
</style>
