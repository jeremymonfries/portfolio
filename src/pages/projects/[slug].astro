---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatBlock from '../../components/StatBlock.astro';
import Tldr from '../../components/Tldr.astro';

export async function getStaticPaths() {
  const entries = await getCollection('case-studies', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'case-studies'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} — Jeremy Monfries`} description={entry.data.summary}>
  <article class="hero-section">
    <h1 class="title">{entry.data.title}</h1>
    <p class="summary">{entry.data.summary}</p>
    {entry.data.heroImage && (
      <div class="hero-frame">
        <Image
          src={entry.data.heroImage.src}
          alt={entry.data.heroImage.alt}
          width={1180}
          height={700}
          loading="eager"
          fetchpriority="high"
          class="hero-image"
        />
      </div>
    )}
  </article>

  <Tldr text={entry.data.tldr} />

  {entry.data.stats.length > 0 && (
    <section class="stats-band" aria-label="Key results">
      <div class="stats-grid">
        {entry.data.stats.map((stat) => (
          <StatBlock value={stat.value} label={stat.label} />
        ))}
      </div>
    </section>
  )}

  <article class="case-body-section">
    <div class="case-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .hero-section {
    padding: var(--space-7) var(--gutter) 0;
    max-width: var(--page-max);
    margin: 0 auto;
  }

  .title {
    font: 200 var(--heading-h1) / var(--heading-leading) var(--font-display);
    margin: 0 0 var(--space-3);
  }

  .summary {
    font: 500 22px / 1.4 var(--font-display);
    color: var(--text-muted);
    max-width: 700px;
    margin: 0 0 var(--space-5);
  }

  /* The frame clips the blur's soft edge spill and the zoom (plus the 1px
     edge halo Chrome can show at high blur), so the reveal stays inside the
     rounded hero shape. */
  /* `clip`, not `hidden`: hidden makes the frame a scroll container, which
     would capture the scroll-driven view() timelines below instead of the
     page. */
  .hero-frame {
    border-radius: 24px;
    overflow: clip;
  }

  .hero-image {
    display: block;
    width: 100%;
    height: auto;
    animation: hero-focus 0.7s cubic-bezier(0.4, 0, 0.2, 1) 0.05s both;
  }

  @keyframes hero-focus {
    from {
      filter: blur(20px);
      opacity: 0;
      transform: scale(1.05);
    }
    to {
      filter: blur(0);
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Scroll-driven defocus as the hero leaves the viewport (modelled on
     CodeFronts' "Backdrop Filter Blur Cross Fade Parallax"). The blur lives
     on a veil over the image, not on the image itself, so only a
     backdrop-filter value is animated. The image also drifts slower than
     the page (individual `translate` composes with the load animation's
     `transform`; the constant `scale` hides the gap the drift would open).
     Browsers without scroll-driven animations just keep the load reveal. */
  @supports (animation-timeline: view()) {
    .hero-frame {
      position: relative;
    }

    .hero-frame::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      backdrop-filter: blur(0);
      background: rgb(255 255 255 / 0);
      animation: hero-veil linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 90%;
    }

    .hero-image {
      scale: 1.08;
      animation:
        hero-focus 0.7s cubic-bezier(0.4, 0, 0.2, 1) 0.05s both,
        hero-drift linear both;
      animation-timeline: auto, view();
      animation-range:
        normal,
        exit 0% exit 100%;
    }
  }

  @keyframes hero-veil {
    to {
      backdrop-filter: blur(18px);
      background: rgb(255 255 255 / 0.35);
    }
  }

  @keyframes hero-drift {
    to {
      translate: 0 3%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image {
      animation: none;
      scale: 1;
    }

    .hero-frame::after {
      display: none;
    }
  }

  /* DS-07/UX-04/UX-12: the original site's stat numbers lived in a plain
     white section with no visual separation from the rest of the page.
     A full-bleed dark band gives the results their own moment and breaks
     up an otherwise all-white page - see rebuild-scope.md section 9.
     Padding matches Tldr/ListBand (the site's other two full-bleed
     bands, both --space-5) rather than the --space-6 this used to have -
     three bands doing the same "full-bleed band directly under the
     hero" job should feel like one consistent rhythm, not two. */
  .stats-band {
    background: var(--surface-sidebar);
    padding: var(--space-5) 0;
  }

  .stats-grid {
    width: min(var(--page-max), calc(100% - 2 * var(--gutter)));
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .stats-band :global(.stat-value) {
    color: var(--color-white);
  }

  .stats-band :global(.stat-label) {
    color: var(--color-neutral-200);
  }

  @media (max-width: 700px) {
    .hero-frame {
      border-radius: 12px;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }

  .case-body-section {
    padding: var(--space-6) var(--gutter) var(--space-7);
    max-width: var(--page-max);
    margin: 0 auto;
  }

  .case-body {
    /* Centered (not flush-left) on wide viewports where the 780px cap is
           narrower than .case-body-section's content width. This also matters
           for ListBand's full-bleed breakout (margin-inline: calc(50% - 50vw)
           in ListBand.astro) - that trick only spans the true viewport width
           when its reference box is itself centered on the page. */
    max-width: 780px;
    margin-inline: auto;
    font-size: 16px;
    line-height: var(--body-leading);
  }

  .case-body :global(h2) {
    font: 700 var(--heading-h3) / var(--heading-leading) var(--font-display);
    margin: var(--space-6) 0 var(--space-3);
    text-align: center;
  }

  .case-body :global(h3) {
    font: 700 var(--heading-h4) / var(--heading-leading) var(--font-display);
    margin: var(--space-5) 0 var(--space-2);
  }

  .case-body :global(h4) {
    font: 700 16px / var(--heading-leading) var(--font-display);
    margin: var(--space-4) 0 var(--space-1);
    color: var(--text-muted);
  }

  .case-body :global(p) {
    margin: 0 0 var(--space-3);
  }

  .case-body :global(ul),
  .case-body :global(ol) {
    margin: 0 0 var(--space-3);
    padding-left: 1.3em;
  }

  .case-body :global(li) {
    margin-bottom: var(--space-1);
  }

  .case-body :global(img) {
    border-radius: 8px;
    margin: var(--space-2) 0 var(--space-4);
  }
</style>
