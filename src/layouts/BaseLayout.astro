---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import SkipLink from '../components/SkipLink.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';

export interface Props {
  title: string;
  description?: string;
  // For pages that exist but aren't meant to show up in search results
  // (e.g. the internal /patterns/ component reference) - keeps them
  // reachable by direct URL without inviting crawlers to index them.
  noindex?: boolean;
}

const {
  title,
  description = 'Jeremy Monfries — UX & product designer portfolio.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <SkipLink />
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <Lightbox />
  </body>
</html>
